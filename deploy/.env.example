# Copiar a backend/deploy/.env para un despliegue nuevo.
# Si ya existe deploy/.env, conservarlo y agregar solo las variables necesarias.
# Generar cada secreto por separado (funciona con Docker en Windows/Mac/Linux):
# docker run --rm python:3.11-slim-bookworm python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obligatorios, sin valor por defecto. No reutilizar claves del ejemplo.
SECRET_KEY=
# En una instalación existente conservar el proyecto y las credenciales de la BD.
COMPOSE_PROJECT_NAME=agroclima-produccion
# Vacío: config/instancia.json, o instancia.example.json si aún no se configuró.
INSTANCIA_CONFIG=
POSTGRES_DB=agroclima
POSTGRES_USER=agroclima
POSTGRES_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1
CORS_ALLOWED_ORIGINS=https://localhost
# Ruta relativa a deploy/; tambien puede ser absoluta (C:/... en Windows).
FRONTEND_DIR=../../frontend
WEB_PORT=80
HTTPS_PORT=443
SECURE_HSTS_SECONDS=3600
ADMIN_HABILITADO=False
DOCS_HABILITADOS=False
GUNICORN_WORKERS=2
INTERVALO_ACTUALIZACION_MIN=360
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Primer administrador (E1C-64): se crea al levantar si no existe; después conviene borrar
# la clave de este archivo. Las demás cuentas las crea un administrador.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Sin las dos de arriba, True crea admin@sistema.local / admin con cambio de clave obligatorio
# (E1C-138). Dejar en False en un servidor expuesto: quien entre primero con esa clave pública
# se quedaría con la cuenta.
ADMIN_POR_DEFECTO=False
# Lecturas del dashboard sin token, solo hasta que el frontend mande el token.
API_LECTURA_PUBLICA=True

# Opcional: cambiar por otro mirror oficial si falla la descarga de Debian.
DEBIAN_MIRROR=https://deb.debian.org/debian
