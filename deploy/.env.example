# Copiar a vigno-backend/deploy/.env para un despliegue nuevo.
# Si ya existe deploy/.env, conservarlo y agregar solo las variables necesarias.
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_LARGA_ALEATORIA
POSTGRES_DB=vigno
POSTGRES_USER=vigno
POSTGRES_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_DISTINTA
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# Ruta relativa a deploy/; tambien puede ser absoluta (C:/... en Windows).
FRONTEND_DIR=../../vigno-fronted
WEB_PORT=80
GUNICORN_WORKERS=2
INTERVALO_ACTUALIZACION_MIN=360
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Clave X-Api-Key para subir Excel y dar de alta estaciones. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INGESTA_API_KEY=REEMPLAZAR_POR_OTRA_CLAVE_LARGA_ALEATORIA
# Para localhost HTTP. Cambiar ambos a True al servir con HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Opcional: cambiar por otro mirror oficial si falla la descarga de Debian.
DEBIAN_MIRROR=https://deb.debian.org/debian

# Clave compartida para las escrituras de la API (X-Api-Key). Vacía bloquea el acceso.
INGESTA_API_KEY=
