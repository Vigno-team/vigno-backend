# =============================================================
# Copiar este archivo a .env y completar los valores locales.
# El .env real NUNCA se sube al repositorio.
# =============================================================

# --- Django ---
SECRET_KEY=cambiar-esta-clave-en-local-y-en-produccion
DEBUG=True
DJANGO_SETTINGS_MODULE=vigno.settings.development
INSTANCIA_CONFIG=
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL ---
POSTGRES_DB=agroclima_db
POSTGRES_USER=agroclima_user
POSTGRES_PASSWORD=clave-local-cambiar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS (origen del frontend React + Vite) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#--- Copernicus ---
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Cuentas y login (E1C-64, E1C-138) ---
# Si no hay ningún administrador, al levantar se crea admin@sistema.local / admin y hay que
# cambiar la clave en el primer ingreso. Para usar otra cuenta, completar estas dos antes de
# levantar por primera vez (la clave: 8+ caracteres, no común, no solo números).
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Lecturas del dashboard sin token, solo hasta que el frontend mande el token.
# Si no se define, todo pide token.
API_LECTURA_PUBLICA=True
# Proxies delante del backend para leer la IP real en el límite de intentos del login.
# En desarrollo no hay proxy: 0. Detrás de nginx (deploy/): 1.
NUM_PROXIES=0

# --- Datos para el frontend (relativa a la raíz del proyecto o absoluta) ---
DATOS_DIR=data/cliente

# --- Recuperar la clave por correo ---
# Sin EMAIL_HOST el sistema funciona igual: en desarrollo el correo con el enlace se escribe en
# `docker compose logs backend` (sirve para probar) y en el despliegue la opción no aparece.
# Para enviarlo de verdad, descomentar y completar (ejemplo con Gmail en el README).
# Vacías, EMAIL_PORT vale 587 y EMAIL_USE_TLS, True.
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=
# DEFAULT_FROM_EMAIL=
# Dirección del frontend, para armar el enlace del correo (vacía: http://localhost:5173).
# FRONTEND_URL=
