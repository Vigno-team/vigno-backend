# =============================================================
# Copiar este archivo a .env y completar los valores locales.
# El .env real NUNCA se sube al repositorio.
# =============================================================

# --- Django ---
SECRET_KEY=cambiar-esta-clave-en-local-y-en-produccion
DEBUG=True
DJANGO_SETTINGS_MODULE=vigno.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL ---
POSTGRES_DB=vigno_db
POSTGRES_USER=vigno_user
POSTGRES_PASSWORD=vigno_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS (origen del frontend React + Vite) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#--- Copernicus ---
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Cuentas y login (E1C-64) ---
# Primer administrador: se crea al levantar el contenedor si no existe (después se pueden borrar).
# La clave tiene que cumplir las reglas de Django (8+ caracteres, no común, no solo números).
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Lecturas del dashboard sin token, solo hasta que el frontend mande el token.
# Si no se define, todo pide token.
API_LECTURA_PUBLICA=True
# Proxies delante del backend para leer la IP real en el límite de intentos del login.
# En desarrollo no hay proxy: 0. Detrás de nginx (deploy/): 1.
NUM_PROXIES=0

# --- Datos para el frontend (relativa a la raíz del proyecto o absoluta) ---
DATOS_DIR=data/cliente
